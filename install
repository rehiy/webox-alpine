#!/bin/sh -e
#

set -e

cd "$(dirname "$0")"
export sdir="$(pwd)"

###########################################################
# install apps

find . -type f -exec sh -c '
    for file do
        IFS= read -r first_line < "$file" || :
        case "$first_line" in
            "#!/bin/"*) chmod +x "$file" ;;
        esac
    done
' sh {} +

for app in wkit "$@"; do
    case "$app" in
        ''|*[!a-zA-Z0-9.-]*|.*)
            echo "> invalid app: $app" >&2
            exit 1
            ;;
    esac
    if [ ! -x "$sdir/$app/install" ]; then
        echo "> unknown app: $app" >&2
        exit 1
    fi
    echo "> install app $app ..."
    cd "$sdir/$app"
    ./install
    echo "> install app $app done"
done

###########################################################
# fix permissions

for file in /etc/logrotate.d/*; do
    if [ -f "$file" ]; then
        chmod 0644 "$file"
    fi
done
for file in /etc/wkit.d/*; do
    if [ -f "$file" ]; then
        chmod 0755 "$file"
    fi
done
