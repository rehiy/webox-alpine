#!/bin/sh -e
#

apk add --no-cache php85 php85-fpm \
    php85-phar \
    php85-bcmath \
    php85-bz2 \
    php85-calendar \
    php85-curl \
    php85-ctype \
    php85-dom \
    php85-exif \
    php85-fileinfo \
    php85-ftp \
    php85-gd \
    php85-gettext \
    php85-iconv \
    php85-intl \
    php85-mbstring \
    php85-mysqli \
    php85-mysqlnd \
    php85-openssl \
    php85-pecl-redis \
    php85-pdo_mysql \
    php85-pdo_pgsql \
    php85-pdo_sqlite \
    php85-pgsql \
    php85-posix \
    php85-session \
    php85-shmop \
    php85-simplexml \
    php85-soap \
    php85-sockets \
    php85-sqlite3 \
    php85-tidy \
    php85-tokenizer \
    php85-xml \
    php85-xmlreader \
    php85-xmlwriter \
    php85-xsl \
    php85-zip

rm -rf /etc/php85/php-fpm.d
rm -rf /var/lib/php85

# fix php cli

if [ ! -e /usr/bin/php ]; then
    ln -sf php85 /usr/bin/php
fi

if [ ! -e /usr/bin/phar ]; then
    ln -sf phar.phar85 /usr/bin/phar
fi

# fix nginx config

sed -i 's#php/#php85/#g' /etc/nginx/http.d/server_fastcgi_php
sed -i 's#php/#php85/#g' /etc/nginx/http.d/server_status

# add profiles

cp -av etc /
cp -av usr /
